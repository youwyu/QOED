<mujoco model="cube">
  <compiler meshdir="assets" texturedir="assets"/>

  <default>
    <default class="cube">
      <geom friction=".3 0.05" conaffinity="2" condim="3"/>
    </default>
  </default>

  <asset>
    <texture name="dexcube" type="2d" file="dex_cube.png"/>
    <material name="dexcube" texture="dexcube"/>
    <mesh name="cube_mesh" file="dex_cube.obj" scale="0.035 0.035 0.035"/>
  </asset>

  <worldbody>
    <body name="cube" childclass="cube" simple="false">
      <freejoint name="cube_freejoint"/>
      <geom type="mesh" mesh="cube_mesh" material="dexcube" contype="0" conaffinity="0" density="0" group="2"/>
      <geom name="cube" type="box" size=".025 .025 .025" mass=".108" group="3"/>
      <site name="cube_center" pos="0 0 0" group="4"/>
    </body>
  </worldbody>
</mujoco>
